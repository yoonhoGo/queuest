{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "queuest",
  "version": "0.1.0",
  "identifier": "com.yoonhogo.queuest",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Queuest",
        "width": 420,
        "height": 640,
        "visible": false,
        "minWidth": 420,
        "maxWidth": 420,
        "minHeight": 640,
        "maxHeight": 640,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
